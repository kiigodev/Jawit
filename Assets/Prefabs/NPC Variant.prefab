PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.hasChoices
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.lines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.option1.choiceText
      value: Baiklah, aku akan melawanmu!
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.option2.choiceText
      value: Teu!
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.lines.Array.data[0].text
      value: Oh? Wajah baru? Apa yang kau inginkan disini?
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.lines.Array.data[1].text
      value: 'Aku ingin mencari benda pusaka untuk membantu temanku Agus kembali
        ke asalnya. apakah kau tau  benda pusaka itu? '
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.lines.Array.data[2].text
      value: 'Ya.. aku sepertinya tau apa yang kau cari. Tetapi aku tidak bisa memberikannya
        secara cuma-cuma. '
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.lines.Array.data[3].text
      value: 'Kamu harus mengalahkanku dalam game Gunting Batu Kertas terlebih dahulu
        untuk memperoleh benda pusaka itu. '
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.lines.Array.data[4].text
      value: 'Kamu harus mengalahkanku dalam game Gunting Batu Kertas terlebih dahulu
        untuk memperoleh benda pusaka itu. '
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.lines.Array.data[0].speakerName
      value: Raras
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.lines.Array.data[2].speakerName
      value: Raras
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.lines.Array.data[3].speakerName
      value: Raras
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.lines.Array.data[4].speakerName
      value: Ucup
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.option2.followUpSequence.lines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.option1.followUpSequence.lines.Array.data[0].text
      value: Baiklah, persiapkan dirimu!
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.option2.followUpSequence.lines.Array.data[0].text
      value: Yahh.. sayang sekali..
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
      propertyPath: mainDialogue.option2.followUpSequence.lines.Array.data[1].text
      value: Baiklah, kalau bgitu kamu bisa mencoba menemui temanku yang berada di
        monumen bandung lautan api, mungkin ia bisa membantumu!
      objectReference: {fileID: 0}
    - target: {fileID: 4621499020171088817, guid: fa1acb994a5b1154db15823dda36da6a,
        type: 3}
